{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meteomatics Weather Authentication API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain OAuth2 bearer token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meteomatics.com/api/v1/token",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Exchange Basic Auth credentials for a short-lived JWT bearer token (valid 2 hours). Use the returned token as `?access_token=<token>` on subsequent requests or as `Authorization: Bearer <token>`.\n"
        }
      ]
    }
  ],
  "bundled": true
}